#include <iostream>
#include <cmath>

using namespace std;

int main() {
    int matrix[5][5];
    int one_row, one_col;

    for (int i = 0; i < 5; ++i) {
        for (int j = 0; j < 5; ++j) {
            cin >> matrix[i][j];
            if (matrix[i][j] == 1) {
                one_row = i + 1; // Convert to 1-based index
                one_col = j + 1; // Convert to 1-based index
            }
        }
    }

    int moves = abs(one_row - 3) + abs(one_col - 3);
    cout << moves << endl;

    return 0;
}
